{
  "name": "holdfast-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:public": "node scripts/prepare-public.mjs",
    "check:public": "node scripts/check-public.mjs",
    "prebuild": "npm run check:public",
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview",
    "publish": "../publish.sh",
    "test": "vitest run",
    "test:screens": "python3 tests/capture.py",
    "test:screens:check": "python3 tests/capture.py --check",
    "test:screens:build": "python3 tests/capture.py --build"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "happy-dom": "^20.10.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  }
}
